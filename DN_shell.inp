! =====================================================================
! Mo hinh shell nhieu lop toan bo duoi ngang DN - sinh tu gen_apdl_DN.py
! Du lieu: main_DN.m, cross_section_analysis_DN.m, material_2D.m, ply.m
! NACA 0015, day cung 550 mm, sai -1.5..1.5 m, ngam chat tai hai dau y = +-1.5 m
! Don vi SI (m, kg, N, Pa).  x: huong ve phia truoc, y: doc sai, z: len
! Nut vo dat tai OML, cac lop dap vao trong (SECOFFSET,TOP, phap tuyen huong ra ngoai)
! Mu dam / side cap: ghep vao laminate vo gia cuong, xep tiep sau cac lop vo
! Bung dam (thanh truoc + foam + thanh sau) va rib: shell sandwich dat tai mat giua
! Huong 0 do cua lop: doc sai (truc y tong the), qua he toa do LOCAL 11
! SHELL181 KEYOPT(3)=2, KEYOPT(8)=2
! =====================================================================
FINISH
/CLEAR,NOSTART
/TITLE,DN horizontal tail - layered shell model from MATLAB data
/PREP7
/NERR,200,10000
ET,1,SHELL181
KEYOPT,1,3,2
KEYOPT,1,8,2
ET,2,SHELL181
KEYOPT,2,3,2
KEYOPT,2,8,2
ET,3,SHELL181
KEYOPT,3,3,2
KEYOPT,3,8,2
ET,4,SHELL181
KEYOPT,4,3,2
KEYOPT,4,8,2
ET,5,SHELL181
KEYOPT,5,3,2
KEYOPT,5,8,2
ET,6,SHELL181
KEYOPT,6,3,2
KEYOPT,6,8,2
ET,7,SHELL181
KEYOPT,7,3,2
KEYOPT,7,8,2
ET,8,MPC184
KEYOPT,8,1,1            ! rigid beam
! TYPE 1: Vo thuong
! TYPE 2: Vo gia cuong + mu dam (truoc & sau)
! TYPE 3: Vo gia cuong + side cap
! TYPE 4: Vo gia cuong (ngoai mu/side cap)
! TYPE 5: Bung dam truoc
! TYPE 6: Bung dam sau
! TYPE 7: Rib
! TYPE 8: Dam cung noi mep rib (thanh dam) voi bung dam (mat giua)
!
! --- Vat lieu 1: lop UD AS4/3501-6 (vi co nhu ply.m; nu23, G23 theo Foye nhu ply3D.m)
MP,EX,1,1.496410e+11
MP,EY,1,8.754539e+09
MP,EZ,1,8.754539e+09
MP,PRXY,1,0.255500
MP,PRYZ,1,0.505469
MP,PRXZ,1,0.255500
MP,GXY,1,5.343500e+09
MP,GYZ,1,2.907578e+09
MP,GXZ,1,5.343500e+09
MP,DENS,1,1610.2000
! --- Vat lieu 2: PVC foam (PVC_Foam.m)
MP,EX,2,7.000000e+07
MP,PRXY,2,0.3
MP,DENS,2,60.0
! --- Vat lieu 3, 4: nhu 1, 2 nhung khong khoi luong (doan bung dam / rib trung voi chieu day vo)
MPCOPY,,1,3
MP,DENS,3,1e-6
MPCOPY,,2,4
MP,DENS,4,1e-6
! Chieu day 1 lop UD = 0.26309 mm; woven = 2 lop UD +-45 (nhu code MATLAB)
!
! --- He toa do dinh huong: truc x cuc bo // truc y tong the (0 do doc sai)
LOCAL,11,0,0,0,0,90
CSYS,0
