! =================== 2. Phan tich dao dong rieng ===================
/SOLU
ANTYPE,MODAL,NEW
FDELE,ALL,ALL
ACEL,0,0,0
NSEL,S,LOC,Y,1.49999,1.50001
NSEL,A,LOC,Y,-1.50001,-1.49999
D,ALL,ALL
NSEL,ALL
MODOPT,LANB,12
MXPAND,12
SOLVE
FINISH
/POST1
SET,LIST
*CFOPEN,DN_results,txt,,APPEND
*VWRITE
('Tan so rieng (Hz)')
*DO,II,1,12
*GET,FRQ,MODE,II,FREQ
*VWRITE,II,FRQ
('  Mode ',F4.0,'   f = ',F10.4,' Hz')
*ENDDO
*CFCLOS
SET,1,1
! Lenh isoparametric view cho bai toan
/VUP,1,Z
/VIEW,1,-1,-1,1
/AUTO,1
/REPLOT
PLDISP,1
! Xem cac mode khac: SET,1,<mode>  roi  PLNSOL,U,SUM
